{
  "name": "blobfish",
  "version": "0.3.0-beta.3",
  "description": "Fast native Azure Blob Storage explorer (Bun + Electron)",
  "license": "MIT",
  "author": "PylotLight <lochois@gmail.com>",
  "type": "module",
  "main": "./out/main/index.js",
  "bin": {
    "blobfish": "./bin/blobfish.mjs"
  },
  "files": [
    "out/**/*",
    "bin/**/*",
    "build/icon.png",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:bare": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron ./out/main/index.js",
    "preview": "electron-vite preview",
    "clean": "rm -rf out",
    "typecheck": "bun check",
    "check:css": "bun scripts/ci/check-css.ts",
    "assets": "bun scripts/make-tray-icon.ts",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:ci": "electron-builder --publish never",
    "release": "bun scripts/release.ts",
    "postinstall": "install-electron",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "build": {
    "appId": "com.pylotlight.blobfish",
    "productName": "Blobfish",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "46.0.0-alpha.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@azure/storage-file-datalake": "^12.31.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
