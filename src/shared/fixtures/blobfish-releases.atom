  <entry>
    <id>tag:github.com,2008:Repository/1401003488/v0.1.0</id>
    <updated>2026-10-03T04:01:10Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/PylotLight/Blobfish/releases/tag/v0.1.0"/>
    <title>v0.1.0</title>
    <content type="html">&lt;h2&gt;[0.1.0] - 2026-10-03&lt;/h2&gt;
&lt;h3&gt;Added&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;(storage)&lt;/strong&gt; Foundational accounts — safeStorage profiles, 3 attach kinds, container/blob listing (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/237f4600bbf110903ac61ee9019fa1315a4579bc&quot;&gt;237f460&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(storage)&lt;/strong&gt; Wizard, tree sidebar, quick access, blob/container CRUD (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/18521bce2236e9d2a1b576faa345e3921fa0aee0&quot;&gt;18521bc&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(ui)&lt;/strong&gt; ASE-style browser, app menu with zoom, drop container dropdown (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/f2c27f81dec27a622b2a50f602a0f5cbd06f1e34&quot;&gt;f2c27f8&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(ui)&lt;/strong&gt; Settings, intentional confirms, smoother rollout, sidebar cleanup (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/b1044169349d7c11d6516c1ff4fd211ce3e0c548&quot;&gt;b104416&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(transfers)&lt;/strong&gt; Queued streaming uploads/downloads with progress dock (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/dd73abeb8412cd668cd162ecf6a4f4194d524809&quot;&gt;dd73abe&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(ui)&lt;/strong&gt; Dialog blur, parent row, sidebar container actions, settings page, accents, sticky toolbar (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/5d618a6cd76007053652e2af1ffaa569ee90b3ac&quot;&gt;5d618a6&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(settings)&lt;/strong&gt; Custom accent color picker (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/e984b163519283c3cccaa250fad74110b0c286e4&quot;&gt;e984b16&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(icons)&lt;/strong&gt; Wire app icon into debug and release builds (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/23314b8d3a672da5e5918cd24d12d76cced1790c&quot;&gt;23314b8&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(release)&lt;/strong&gt; Tag-driven release flow with changelog + homebrew cask (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/6daf36d85a18e8262f1e0f4d5197246f00a36e3d&quot;&gt;6daf36d&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Fixed&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;(ipc)&lt;/strong&gt; Remove duplicate transfers:configure handler (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/c0ff2a66f373f50acad7ae479d9827b4388ebd5e&quot;&gt;c0ff2a6&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(release)&lt;/strong&gt; Don&#39;t fail when version/changelog are unchanged (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/76fc7a52b36395cb283833d22b255919741779cd&quot;&gt;76fc7a5&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(release)&lt;/strong&gt; Match electron-builder&#39;s mac artifact naming (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/fabf2f0f1f04942e54fd9da4e5e58406ddb0230f&quot;&gt;fabf2f0&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Other&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Initial commit (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/2941127fa5df075422d72c5112a631101a8102d7&quot;&gt;2941127&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Blobfish identity on starter template (config, package, readme) (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/9718d04614759cf98264fabd561785edc44b67a8&quot;&gt;9718d04&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add app build/icon assets (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/d4780b7d445fc77be83edf8161ff639de448e3cb&quot;&gt;d4780b7&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;</content>
