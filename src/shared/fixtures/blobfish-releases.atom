  <entry>
    <id>tag:github.com,2008:Repository/1401003488/v0.2.1</id>
    <updated>2026-10-08T01:37:01Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/PylotLight/Blobfish/releases/tag/v0.2.1"/>
    <title>v0.2.1</title>
    <content type="html">&lt;h2&gt;[0.2.1] - 2026-10-08&lt;/h2&gt;
&lt;h3&gt;Fixed&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;(ui)&lt;/strong&gt; Scope error banners per view so container 403s don&#39;t cover blobs (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/1543f69e33f46ef65c271a4791d29a30d35ac8c0&quot;&gt;1543f69&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(azure)&lt;/strong&gt; Skip container probe for scoped attachments (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/a7b5c2975280e769f5ee44020d1f895cc4cb1034&quot;&gt;a7b5c29&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(ui)&lt;/strong&gt; Honest container-list failure states (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/84bf401bf50b0d38a09ba2201df1549083b9241f&quot;&gt;84bf401&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;</content>
