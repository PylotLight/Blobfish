  <entry>
    <id>tag:github.com,2008:Repository/1401003488/v0.2.2</id>
    <updated>2026-10-08T02:48:55Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/PylotLight/Blobfish/releases/tag/v0.2.2"/>
    <title>v0.2.2</title>
    <content type="html">&lt;h2&gt;[0.2.2] - 2026-10-08&lt;/h2&gt;
&lt;h3&gt;Added&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;(preview)&lt;/strong&gt; Resizable CSV columns with content autosize, table polish (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/3651c1081034f5b66ac9712221b52b7b73429852&quot;&gt;3651c10&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(preview)&lt;/strong&gt; Excel-style column options popover (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/01de085f1d4f8c325bdfd1e1950c0bf29acc95a9&quot;&gt;01de085&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(blobs)&lt;/strong&gt; Move/clone blobs into a folder (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/46aa5c9a88cd8726379ffba1eedb536743ffb70e&quot;&gt;46aa5c9&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(blobs)&lt;/strong&gt; Visual folder picker for move/copy destination (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/221fd7a03ca1ac01166aff4dd0817e697a7a8d3e&quot;&gt;221fd7a&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(ui)&lt;/strong&gt; Dashboard home on launch (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/e49b5d012d35c8eec29d59bdc1004a1e1ab2c833&quot;&gt;e49b5d0&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(transfers)&lt;/strong&gt; Inline delete for downloaded files (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/ec347626c27eb00f4c68af77f94b7f69283d4f47&quot;&gt;ec34762&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(blobs)&lt;/strong&gt; Deleted view with undelete plus version history restore (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/4565842dd0b98395c321847c67c871393eabe106&quot;&gt;4565842&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(transfers)&lt;/strong&gt; File completed transfers to activity, single feed (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/c8688dc6972f868a73fafd7c2425092b1e555662&quot;&gt;c8688dc&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Fixed&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;(ui)&lt;/strong&gt; Compact horizontal home hero, wider page (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/28ab01bffdeb032436576cd639593cbccce19f6d&quot;&gt;28ab01b&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(blobs)&lt;/strong&gt; List-based collision check for move/copy (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/ac8e0ec6a585f995ce73491c02724e273b34aba2&quot;&gt;ac8e0ec&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(blobs)&lt;/strong&gt; Replace-existing option, provable conflicts, batch dupes (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/e961aedfa2b473f0237fb9d6578002dd3e8f5aec&quot;&gt;e961aed&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(blobs)&lt;/strong&gt; Delete confirm previews blast radius, audit names (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/d6df06daaca31386d104b776c6028c9a96bad5b0&quot;&gt;d6df06d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(ui)&lt;/strong&gt; Clickable home button, inline row actions, compact sidebar actions (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/a05c67099651448960cb0a9914bf4ad702be4ed4&quot;&gt;a05c670&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(transfers)&lt;/strong&gt; Delete feedback on transfer rows, download-only file actions (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/b4850ac7ed34c92d58b77f2347b95ca5ff9ea872&quot;&gt;b4850ac&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(ui)&lt;/strong&gt; Hover row actions, roomier new-connection button (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/7ef5a240ca23c55432940a56aa1ef57bc843c013&quot;&gt;7ef5a24&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(ui)&lt;/strong&gt; Row actions in overflow menu, never over names (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/febe6baf75649af84da034245a0f8863a2b91bab&quot;&gt;febe6ba&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;</content>
