  <entry>
    <id>tag:github.com,2008:Repository/1401003488/v0.2.0</id>
    <updated>2026-10-07T16:44:25Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/PylotLight/Blobfish/releases/tag/v0.2.0"/>
    <title>v0.2.0</title>
    <content type="html">&lt;h2&gt;[0.2.0] - 2026-10-07&lt;/h2&gt;
&lt;h3&gt;Added&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;(accounts)&lt;/strong&gt; Copy/export connection secret per connection (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/9933d5c2f6ee76bf193c8a83f36fce0ba03a8853&quot;&gt;9933d5c&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(transfers)&lt;/strong&gt; Open/reveal downloaded files from dock (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/ca92eb53a3c5e6cf40d26a61af5d62ea19de75ff&quot;&gt;ca92eb5&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;(preview)&lt;/strong&gt; Sortable and filterable CSV columns (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/634528ab4c1caeddcb9d62c852c1ada4649e5cb4&quot;&gt;634528a&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Fixed&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;(transfers)&lt;/strong&gt; Download selected files flat, not parent dir (&lt;a href=&quot;https://github.com/PylotLight/Blobfish/commit/7ac904f6476b067f3c88eb3f46efd90ca5d6306e&quot;&gt;7ac904f&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;</content>
